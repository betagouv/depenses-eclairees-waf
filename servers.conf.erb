limit_req_zone "login_limit" zone=login_zone:1m rate=1r/s;

server {
    server_name localhost;
    listen <%= ENV['PORT'] %>;
    charset utf-8;

    # Enable modsecurity
    modsecurity on;
    modsecurity_rules_file /app/metabase_rules.txt;

    # Force dns resolution to handle upstream ip changes
    # See /etc/resolv.conf for default resolver ip
    resolver 127.0.0.11 valid=10s;

    # Proxy headers
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    location /auth/login {
        # Rate limit auth endpoint
        limit_req zone=login_zone burst=3;
        proxy_pass <%= ENV["UPSTREAM_URL"] %>;
        proxy_redirect default;
    }
    location / {
        proxy_pass <%= ENV["UPSTREAM_URL"] %>;
        proxy_redirect default;
    }
}

