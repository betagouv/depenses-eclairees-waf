# Increase default size to allow multiple server blocks
server_names_hash_bucket_size 128;

# Force dns resolution to handle upstream ip changes
# See /etc/resolv.conf for default resolver ip
resolver 127.0.0.11 valid=5s ipv6=off;

<%
# One entry per proxied application. `name` must be unique: it drives the
# limit_req_zone, upstream and zone names.
apps = [
    {
        title: "Metabase",
        name: "metabase",
        host: ENV["METABASE_HOST"],
        upstream: ENV["METABASE_UPSTREAM_SERVER"],
        login_path: ENV["METABASE_LOGIN_PATH"],
        rules: "metabase_rules.txt",
    },
    {
        title: "DEPEC - WEBAPP",
        name: "depec_web",
        host: ENV["DEPEC_WEB_HOST"],
        upstream: ENV["DEPEC_WEB_UPSTREAM_SERVER"],
        login_path: ENV["DEPEC_WEB_ADMIN_LOGIN_PATH"],
        rules: nil,
    },
    {
        title: "GESEC - WEBAPP",
        name: "gesec_web",
        host: ENV["GESEC_WEB_HOST"],
        upstream: ENV["GESEC_WEB_UPSTREAM_SERVER"],
        login_path: ENV["GESEC_WEB_ADMIN_LOGIN_PATH"],
        rules: nil,
    },
    {
        title: "SFTP - WEBAPP",
        name: "sftp_web",
        host: ENV["SFTP_WEB_HOST"],
        upstream: ENV["SFTP_WEB_UPSTREAM_SERVER"],
        login_path: ENV["SFTP_WEB_ADMIN_LOGIN_PATH"],
        rules: nil,
    },
    {
        title: "N8N",
        name: "n8n",
        host: ENV["N8N_HOST"],
        upstream: ENV["N8N_UPSTREAM_SERVER"],
        login_path: ENV["N8N_LOGIN_PATH"],
        rules: "n8n_rules.txt",
    },
]
%>
###########################################
# Default server
###########################################

server {
    server_name localhost default_server;
    listen <%= ENV["PORT"] %>;
    charset utf-8;

    location / {
        return 200 "Ok";
        add_header Content-Type text/plain;
    }
}
<% apps.each do |app| %>

###########################################
# <%= app[:title] %>
###########################################

# Rate limit on login
limit_req_zone "<%= app[:name] %>_login_limit" zone=<%= app[:name] %>_login_zone:1m rate=1r/s;

# Upstream
upstream <%= app[:name] %>_backend {
    server <%= app[:upstream] %> resolve;
    keepalive 16;
    zone <%= app[:name] %>_backend 64k;
}

server {
    server_name <%= app[:host] %>;
    listen <%= ENV["PORT"] %>;
    charset utf-8;

    # Enable modsecurity
    modsecurity on;<%= app[:rules] ? "\n    modsecurity_rules_file /app/#{app[:rules]};" : "" %>

    # Performance improvement
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # Proxy headers
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location <%= app[:login_path] %> {
        # Rate limit auth endpoint
        limit_req zone=<%= app[:name] %>_login_zone burst=3;
        proxy_pass http://<%= app[:name] %>_backend;
        proxy_redirect default;
    }
    location / {
        proxy_pass http://<%= app[:name] %>_backend;
        proxy_redirect default;
    }
}
<% end %>
